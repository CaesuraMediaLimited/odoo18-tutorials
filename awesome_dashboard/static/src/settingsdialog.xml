<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_dashboard.SettingsDialog">
        <Dialog size="'md'" title="'Dashboard Settings'">
            <div class="p-3">
                <t t-foreach="props.dashboardItems" t-as="item" t-key="item[0]">
                    <div class="form-check">
                        <input
                           type="checkbox"
                           class="form-check-input"
                           t-att-id="item[0]"
                           t-att-checked="checked.has(item[0])"
                           t-on-click="() => toggleCheckbox(item[0])"
                        />
                        <label class="form-check-label" t-att-for="item[1].id">
                            <t t-esc="item[1].description"/>
                        </label>
                    </div>
                </t>
                <div class="mt-3">
                    <button class="btn btn-primary" t-on-click="saveAndClose">Save</button>
                    <button class="btn btn-secondary ms-2" t-on-click="closeDialog">Cancel</button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>

