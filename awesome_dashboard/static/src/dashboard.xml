<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="display">
           <div class="container-fluid">
              <button class="btn button-primary" t-on-click="openCustomers">Customers</button>
              <button class="btn button-primary" t-on-click="openLeads">Leads</button>

              <hr />
              <div class="row">
                 <t t-foreach="items" t-as="item" t-key="item.id">
                    <div class="col-4">
                       <p><t t-esc="item.description" /></p>
                       <DashboardItem size="item.size || 1">
                          <t t-set="itemProp" t-value="item.props ? item.props(stats.stats) : {'data': statistics}"/>
                          <t t-component="item.Component" t-props="itemProp" />
                       </DashboardItem>
                    </div>
                 </t>
              </div>
              <hr />

              <!--
              <div class="row">
                 <div class="col-4">
                 </div>
                 <div class="col-4">
                    <PieChart
                       small="stats.stats.orders_by_size.s"
                       medium="stats.stats.orders_by_size.m"
                       extraLarge="stats.stats.orders_by_size.xl"
                    />
                 </div>
                 <div class="col-4">
                 </div>
              </div>
              -->
           </div>
        </Layout>
    </t>

</templates>
