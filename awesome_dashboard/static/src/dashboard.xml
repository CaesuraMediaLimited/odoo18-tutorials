<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout className="'o_dashboard h-100'" display="display">
           <div class="container-fluid">
              <button class="btn button-primary" t-on-click="openCustomers">Customers</button>
              <button class="btn button-primary" t-on-click="openLeads">Leads</button>
              <button class="btn btn-light"      t-on-click="openDialog">
                 Settings
              </button>

              <hr />
              <div class="row">
                 <t t-foreach="items" t-as="item" t-key="item[0]">
                    <div class="col-4">
                       <p><t t-esc="item[1].description" /></p>
                       <DashboardItem size="item[1].size || 1">
                          <t t-set="itemProp" t-value="item[1].props ? item[1].props(stats.stats) : {'data': stats.stats}"/>
                          <t t-component="item[1].Component" t-props="itemProp" />
                       </DashboardItem>
                    </div>
                 </t>
              </div>
              <hr />
           </div>
        </Layout>
    </t>

</templates>
