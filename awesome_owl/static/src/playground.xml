<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Counter component -->
    <t t-name="awesome_owl.Counter">
        <div class="p-3 border rounded m-2">
            <h6><t t-esc="props.name"/></h6>
            <button class="btn btn-primary" t-on-click="increment">Increment</button>
            <p>Counter: <t t-esc="state.value"/></p>
        </div>
    </t>

    <!-- Card component -->
    <t t-name="awesome_owl.Card">
        <div class="card">
           <div class="card-header">
              <button t-on-click="toggleOpen">Open/Close</button>
              <t t-slot="header" />
           </div>
           <div class="card-body">
              <div t-if="open.open">
                 <t t-slot="body" />
              </div>
           </div>
           <div class="card-footer">
              <t t-slot="footer" />
           </div>
        </div>
    </t>

    <!-- ToDo Item component -->
    <t t-name="awesome_owl.TodoItem">
        <div class="p-3 border rounded m-2 row" t-att-class="{'text-muted text-decoration-line-through': props.isCompleted}">
           <div class="col-2">
              <input
                 type="checkbox"
                 class="m-1"
                 id="done-checkbox"
                 name="done-checkbox"
                 title="Mark as done"
                 t-att-checked="props.isCompleted"
                 t-on-change="toggle"
              />
           </div>
           <div class="col-3">
              <t t-esc="props.id"/>
           </div>
           <div class="col-3">
              <t t-esc="props.description"/>
           </div>
           <div class="col-3">
              <t t-esc="props.isCompleted"/>
           </div>
           <div class="col-1">
              <span class="fa fa-remove" t-on-click="removeThis" />
           </div>
        </div>
    </t>
    <!-- ToDo List component -->
    <t t-name="awesome_owl.TodoList">
        <div class="p-3 border rounded m-2">
           <input
              t-ref='input_ref'
              class="form-control mb-3"
              type="text"
              id="new-todo"
              name="new-todo"
              placeholder="Add a new task"
              t-on-keyup="addTodo"
           />
           <t t-foreach="todos" t-as="i" t-key="i.id">
              <TodoItem
                 id="i.id"
                 description="i.description"
                 isCompleted="i.isCompleted"
                 toggleDone.bind="toggleDone"
                 removeTodo.bind="removeTodo"
              />
           </t>
        </div>
    </t>

    <!-- Playground template -->
    <t t-name="awesome_owl.Playground">
        <div class="d-flex flex-wrap">
            <Counter name="'One'"   updateCount.bind="updateCount"/>
            <Counter name="'Two'"   updateCount.bind="updateCount"/>
            <Counter name="'Three'" updateCount.bind="updateCount"/>
            <Counter name="'Four'"  updateCount.bind="updateCount"/>
        </div>
        <p>Total count is <t t-esc="state.counter"/></p>
        <div class="d-flex flex-wrap">
           <Card>
              <t t-set-slot="header">Counter One</t>
              <t t-set-slot="body"><Counter name="'One'" updateCount.bind="updateCount"/></t>
              <t t-set-slot="footer">footer one</t>
           </Card>
           <Card>
              <t t-set-slot="header">Counter Two</t>
              <t t-set-slot="body"><Counter name="'Two'" updateCount.bind="updateCount"/></t>
              <t t-set-slot="footer">footer two</t>
           </Card>
        </div>
        <TestComponent />
        <div>
           <h3>To Do List</h3>
           <TodoList />
        </div>
        <!--
        <MouseMove />
        -->
    </t>
</templates>

