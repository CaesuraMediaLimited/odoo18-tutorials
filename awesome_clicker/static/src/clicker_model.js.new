import { Reactive } from "@web/core/utils/reactive";

export class ClickerModel extends Reactive {

    constructor(...args) {
        super(...args);
        this.setup(...args); 
    }

    setup(env) {
       this.state      = reactive({ clicks: 0, numClickBots : 0, level : 0 });
       this.timerGoing = reactive ({yes : false});

       useExternalListener(document.body, "click", (ev) => {
          if (ev.target.id == "button" || ev.target.id == "icon") {
             return false;
          }
          this.increment(1);
       });

    }

    update(numClickBots) {
       this.state.numClickBots = numClickBots;
         if (!this.timerGoing.yes) {
            setInterval (function () {
               this.increment (10 * this.state.numClickBots);
               console.log ("Timer inc : ", this.state.numClickBots, this.state.numClickBots);
            }, 10000);
            this.timerGoing.yes = true;
         }

    } 

    increment (numClicks) {
       this.state.clicks += numClicks;
       console.log ("ClickerModel : increment : ", numClicks, this.state.clicks);
    }

    humanValue () {
       return  humanNumber(this.state.clicks);
    }

    tooltip () {
       return this.state.clicks.toLocaleString?.() ?? String (this.state.clicks);
    }

    buyBots () {
       if (this.state.level > 0) {
          this.state.clickBots++;
          this.update(this.state.clickBots);
       }
    }

    canBuyClickBots () {
       if (this.state.level > 0) {
          return "";
       } else {
          return "disabled";
       }
    }
}

