<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
   
    <t t-name="awesome_clicker.ClientAction" owl="1">
        <div class="container-fluid">
           <p>Client Action</p>
           <p>Clicks : <ClickValue value="clicker.state.clicks" /> </p>
           <button class="btn" t-on-click="addTen">
              <i id="icon" style="font-size:20px" class="fa fa-plus"/>
           </button>
           <hr />
           <div>
              <h2>Bots</h2>
              <p><t t-esc="state.clickBots"/>x ClickBots (10 clicks/10 seconds)</p>
           </div>
           <button class="btn btn-primary" t-on-click="buyBots" t-att-disabled="canBuyClickBots()">
              Buy ClickBot (1000 clicks)
           </button>
        </div>
    </t>

</templates>

