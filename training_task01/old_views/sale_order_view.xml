<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- Inherit the Sale Order Form View -->
    <record id="view_order_form_inherit_salesperson" model="ir.ui.view">
      <field name="name">sale.order.form.salesperson.inherit</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='user_id']" position="attributes">
          <attribute name="groups">training_task01.group_sales_person_editor</attribute>
        </xpath>
      </field>
    </record>

  </data>
</odoo>
