<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_users_form" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.training.task</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='website']" position="after">
        <field name="contact_status" readonly="1"/>
        <field name="total_est_revenue"/>
        <field name="customer_grades_id"/>
        <field name="company_contact_address_id" invisible="is_company"/>
        <field name="credit_limit"/>
      </xpath>
      <xpath expr="//field[@name='property_payment_term_id']" position="attributes">
        <attribute name="invisible">True</attribute>
      </xpath>
      <xpath expr="//field[@name='invoice_sending_method']" position="after">
        <field
          string="Payment Terms"
          name="property_payment_term_id"
          options="{'no_open': True, 'no_create': True}"
          groups="account.group_account_invoice,account.group_account_readonly"
        />
      </xpath>
    </field>
  </record>
  <record id="view_other_addresses_form" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.other.addresses</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Other Addresses" invisible="not is_company">
          <field name="child_ids">
            <list editable="bottom">
              <field name="name"/>
              <field name="vat"/>
              <field name="street"/>
              <field name="street2"/>
              <field name="city"/>
              <field name="state_id" ref="l10n_pk.state_pk_sd"/>
              <field name="country_id" ref="base.pk"/>
              <field name="zip"/>
              <field name="phone"/>
              <field name="email"/>
              <field name="website"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
