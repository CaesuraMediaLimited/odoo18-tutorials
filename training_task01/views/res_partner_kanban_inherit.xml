<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <record id="view_res_partner_kanban_inherit" model="ir.ui.view">
     <field name="name">res.partner.kanban.inherit.new_tab_link</field>
     <field name="model">res.partner</field>
     <field name="inherit_id" ref="base.res_partner_kanban_view"/>
     <field name="arch" type="xml">
       <xpath expr="//footer/div" position="inside">
         <a t-attf-href="/odoo/res.partner/{{ record.id.raw_value }}"
            target="_blank"
            onclick="event.stopPropagation();"
            t-attf-title="Open {{ record.email.raw_value }} in new window/tab"
         >
            <i class="oi oi-view"/>
         </a>
       </xpath>
     </field>
   </record>
</odoo>
