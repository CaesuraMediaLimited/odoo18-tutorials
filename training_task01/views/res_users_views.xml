<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_salesperson_tree" model="ir.ui.view">
    <field name="name">res.users.salesperson.list</field>
    <field name="model">res.users</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="is_sales_person" widget="boolean_toggle"/>
      </list>
    </field>
  </record>
  <record id="view_users_form_inherit_salesperson" model="ir.ui.view">
    <field name="name">res.users.form.inherit.salesperson</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_simple_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='login']" position="before">
        <label for="is_sales_person"/>
        <div>
          <field name="is_sales_person" widget="boolean_toggle"/>
        </div>
      </xpath>
    </field>
  </record>
  <record id="action_salesperson" model="ir.actions.act_window">
    <field name="name">Sales People</field>
    <field name="res_model">res.users</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_salesperson_tree"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Sales People
      </p>
    </field>
  </record>
  <menuitem
    action="action_salesperson"
    id="salesperson_menu_item"
    name="Sales People"
    sequence="2"
    parent="contacts.res_partner_menu_config"
  />
</odoo>
