<?xml version="1.0"?>
<odoo>
  <record id="training_task_view_tree" model="ir.ui.view">
    <field name="name">training.task.name</field>
    <field name="model">training.task</field>
    <field name="arch" type="xml">
      <list string="List Name">
        <field name="name"/>
        <field name="description"/>
      </list>
    </field>
  </record>
  <record id="training_task_view_form" model="ir.ui.view">
    <field name="name">training.task.form</field>
    <field name="model">training.task</field>
    <field name="arch" type="xml">
      <form string="Training Task Form">
        <sheet>
          <label for="name"/>
          <field name="name"/>
          <label for="description"/>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="training_task" model="ir.actions.act_window">
    <field name="name">Training Task</field>
    <field name="res_model">training.task</field>
    <field name="view_mode">list,form,kanban</field>
  </record>
</odoo>
