<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_customer_grades_tree" model="ir.ui.view">
    <field name="name">res.partner.grades.list</field>
    <field name="model">res.partner.grades</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="minimum"/>
        <field name="maximum"/>
      </list>
    </field>
  </record>
  <record id="view_customer_grades_form" model="ir.ui.view">
    <field name="name">res.partner.grades.form</field>
    <field name="model">res.partner.grades</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="minimum"/>
            <field name="maximum"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_customer_grades" model="ir.actions.act_window">
    <field name="name">Customer Grades</field>
    <field name="res_model">res.partner.grades</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Customer Grades
      </p>
    </field>
  </record>
  <menuitem
     action="action_customer_grades"
     id="customer_grades_menu_item"
     name="Customer Grades"
     sequence="2"
     parent="contacts.res_partner_menu_config"
  />
</odoo>
