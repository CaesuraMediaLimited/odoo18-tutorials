<?xml version="1.0"?>
<odoo>
   <record id="estate_property_view_tree" model="ir.ui.view">
       <field name="name">estate.property.name</field>
       <field name="model">estate.property</field>
       <field name="arch" type="xml">
           <list string="List Name" decoration-success="expected_price &gt; 30000" decoration-warning="bedrooms &gt; 2">
               <field name="name"/>
               <field name="postcode"/>
               <field name="bedrooms"/>
               <field name="living_area"/>
               <field name="expected_price"/>
               <field name="selling_price"/>
               <field name="date_availability"/>
           </list>
       </field>
   </record>
     <record id="estate_property_view_kanban" model="ir.ui.view">
       <field name="name">estate.property.view.kanban</field>
       <field name="model">estate.property</field>
       <field name="arch" type="xml">
         <kanban default_group_by="property_type_id" records_draggable="False">
            <!-- add records here e record.state-->
            <field name="state"/>
            <templates>
               <t t-name="kanban-box">
                  <div>
                     <h3><field name="name"/></h3>
                     <div t-if="record.state.raw_value == 'new'">
                        This is new!
                    </div>
                     <p>Expected Price : <field name="expected_price"/></p>
                     <div t-if="record.best_price.raw_value &gt; 0">
                        Best Price : <field name="best_price"/>
                     </div>
                     <div>
                        Selling Price : <field name="selling_price"/>
                     </div>
                     <div>
                        <field name="property_tag_id" widget="many2many_tags" options="{'color_field': 'colour'}"/>
                     </div>
                  </div>
               </t>
            </templates>
         </kanban>
      </field>
   </record>

   <record id="estate_property_view_form" model="ir.ui.view">
       <field name="name">estate.property.form</field>
       <field name="model">estate.property</field>
       <field name="arch" type="xml">
           <form string="Estate Property Form">
               <sheet>
                  <h1><field name="name"/></h1>
                  <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,cancelled"/>
                  <label for="property_tag_id"/>
                  <field name="property_tag_id" widget="many2many_tags" options="{'color_field': 'colour'}"/>
                  <button name="set_property_sold" type="object" string="Sold" icon="fa-address-card"/>
                  <button name="set_property_cancelled" type="object" string="Cancel" icon="fa-address-card"/>
                  <label for="best_price"/>
                  <field name="best_price"/>
                  <notebook>
                     <page string="Description">
                        <div class="row">
                           <div class="col-6">
                              <label for="property_type_id"/>
                           </div>
                           <div class="col-6">
                              <field name="property_type_id" options="{'no_create': true, 'no_open': true}"/>
                           </div>
                           <div class="col-6">
                              <label for="postcode"/>
                           </div>
                           <div class="col-6">
                              <field name="postcode"/>
                           </div>
                           <div class="col-6">
                              <label for="bedrooms"/>
                           </div>
                           <div class="col-6">
                              <field name="bedrooms"/>
                           </div>
                           <div class="col-6">
                              <label for="living_area"/>
                           </div>
                           <div class="col-6">
                              <field name="living_area"/>
                           </div>
                           <div class="col-6">
                              <label for="expected_price"/>
                           </div>
                           <div class="col-6">
                              <field name="expected_price"/>
                           </div>
                           <div class="col-6">
                              <label for="selling_price"/>
                           </div>
                           <div class="col-6">
                              <field name="selling_price"/>
                           </div>
                           <div class="col-6">
                              <label for="date_availability"/>
                           </div>
                           <div class="col-6">
                              <field name="date_availability"/>
                           </div>
                           <div class="col-6">
                              <label for="garden"/>
                           </div>
                           <div class="col-6">
                              <field name="garden"/>
                           </div>
                           <div class="col-6">
                              <label for="garden_area" invisible="not garden"/>
                           </div>
                           <div class="col-6">
                              <field name="garden_area" invisible="not garden"/>
                           </div>
                           <div class="col-6">
                              <label for="garden_orientation" invisible="not garden"/>
                           </div>
                           <div class="col-6">
                              <field name="garden_orientation" invisible="not garden"/>
                           </div>
                           <div class="col-6">
                              <label for="state"/>
                           </div>
                           <div class="col-6">
                              <field name="state"/>
                           </div>
                        </div>
                     </page>
                     <page string="More Info">
                        <div class="row">
                           <div class="col-6">
                              <label for="salesperson_id"/>
                           </div>
                           <div class="col-6">
                              <field name="salesperson_id"/>
                           </div>
                           <div class="col-6">
                              <label for="buyer_id"/>
                           </div>
                           <div class="col-6">
                              <field name="buyer_id"/>
                           </div>
                        </div>
                     </page>
                     <page string="Offers">
                        <div class="row">
                           <div class="col-6">
                              <label for="offer_ids"/>
                           </div>
                           <div class="col-6">
                              <field name="offer_ids"/>
                           </div>
                        </div>
                     </page>
                  </notebook>
               </sheet>
           </form>
       </field>
   </record>

   <record id="estate_property_view_filter" model="ir.ui.view">
      <field name="name">estate.property.filter</field>
      <field name="model">estate.property</field>
      <field name="arch" type="xml">
         <search string="Search Properties">
            <field name="name"/>
            <field name="postcode"/>
            <field name="garden_orientation"/>
            <field name="date_availability"/>
            <field name="selling_price"/>
            <field name="bedrooms"/>
            <field name="expected_price"/>
            <field name="living_area"/>
            <field name="state"/>
            <filter string="Available Properties" name="available_properties" domain="['|', ('state', '=', 'offer_received'), ('state', '=', 'new')]"/>
         </search>
      </field>
   </record>

    <record id="estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_available_properties': True}</field>
    </record>

</odoo>
